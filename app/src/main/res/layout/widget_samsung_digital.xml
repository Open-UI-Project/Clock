<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/layout_time_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/text_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <TextClock
            android:id="@+id/text_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:format12Hour="EEE, d MMMM"
            android:format24Hour="EEE, d MMMM"
            android:includeFontPadding="false"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layout_alarm_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/samsung_alarm_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/tab_alarm"
                android:src="@drawable/ic_alarm_widget" />

            <TextView
                android:id="@+id/samsung_alarm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/widget_alarm_off"
                android:textColor="#E0E7FF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_weather_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/samsung_weather_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/widget_weather_title"
                android:src="@drawable/ic_weather_sunny" />

            <TextView
                android:id="@+id/samsung_temp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:shadowColor="#D9000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="22°"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/samsung_condition_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/samsung_city_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text=""
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
